// Prisma Schema for OutMedia (Hybrid TikTok + Discord Platform)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USER & PRESENCE
// -------------------------------------------------------------
enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  email         String       @unique
  displayName   String
  avatarUrl     String?
  bio           String?
  status        UserStatus   @default(OFFLINE)
  customStatus  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // TikTok Relations
  videos        Video[]
  videoLikes    VideoLike[]
  videoComments VideoComment[]

  // Friendship Relations (Discord Style)
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")

  // Direct Messaging Relations
  sentDirectMessages     DirectMessage[] @relation("DMSender")
  receivedDirectMessages DirectMessage[] @relation("DMReceiver")

  // Discord Server & Voice Relations
  serverMemberships      ServerMember[]
  createdServers         Server[]        @relation("ServerOwner")
  voiceState             VoiceState?
  channelMessages        ChannelMessage[]

  @@index([username])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

// -------------------------------------------------------------
// TIKTOK VIDEO FEED
// -------------------------------------------------------------
model Video {
  id            String         @id @default(uuid())
  authorId      String
  videoUrl      String         // Public CDN / HLS Stream
  posterUrl     String?
  caption       String
  soundTitle    String         @default("Audio Asli")
  soundArtist   String         @default("Kreator")
  durationSec   Float          @default(0.0)
  likesCount    Int            @default(0)
  commentsCount Int            @default(0)
  sharesCount   Int            @default(0)
  createdAt     DateTime       @default(now())

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes         VideoLike[]
  comments      VideoComment[]

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
}

model VideoLike {
  id        String   @id @default(uuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@index([videoId])
}

model VideoComment {
  id        String   @id @default(uuid())
  videoId   String
  userId    String
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

// -------------------------------------------------------------
// DIRECT MESSAGES (1-on-1 Chat)
// -------------------------------------------------------------
model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  mediaUrl   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// DISCORD SERVER & VOICE SPACES
// -------------------------------------------------------------
model Server {
  id          String         @id @default(uuid())
  name        String
  iconUrl     String?
  description String?
  ownerId     String
  createdAt   DateTime       @default(now())

  owner       User           @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ServerMember[]
  channels    Channel[]

  @@index([ownerId])
}

enum ServerRole {
  OWNER
  ADMIN
  MEMBER
}

model ServerMember {
  id        String     @id @default(uuid())
  serverId  String
  userId    String
  role      ServerRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  server    Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId])
}

enum ChannelType {
  TEXT
  VOICE
}

model Channel {
  id        String         @id @default(uuid())
  serverId  String
  name      String
  type      ChannelType    @default(TEXT)
  topic     String?
  createdAt DateTime       @default(now())

  server    Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages  ChannelMessage[]
  voiceUsers VoiceState[]

  @@index([serverId])
}

model ChannelMessage {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  content   String
  mediaUrl  String?
  createdAt DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model VoiceState {
  id         String   @id @default(uuid())
  channelId  String
  userId     String   @unique
  isMuted    Boolean  @default(false)
  isDeafened Boolean  @default(false)
  isSpeaking Boolean  @default(false)
  joinedAt   DateTime @default(now())

  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId])
}
