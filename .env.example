# ==============================================================================
# PlanCraft PRO — Supabase Environment Configuration
# ==============================================================================
# Dapatkan kredensial ini di dashboard Supabase Anda:
# https://supabase.com -> Project Settings -> API
# ==============================================================================

# 1. Project URL (Contoh: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anon Key (Contoh: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
SUPABASE_ANON_KEY=your-anon-key-here

# Catatan:
# Anda juga dapat langsung memasukkan Project URL dan Anon Key
# melalui tombol "Supabase" di aplikasi (tanpa perlu restart server).
